# Copy to .env and fill in your own values.
# The app runs fully in MOCK MODE without these — chat answers are synthesized
# from retrieved document chunks with references. Set USER_LLM_API_KEY to
# enable real LLM answers.
#
# IMPORTANT: .env.example is committed to the (public) repo — never put a real
# key here. Put your real key only in .env, which is gitignored.

# Your own LLM provider (any OpenAI-compatible chat completions API)
# Example for a local OpenAI-compatible gateway (works only when the app runs
# on the same machine as the gateway; the hosted preview cannot reach localhost):
#   USER_LLM_BASE_URL=http://localhost:20128/v1
#   USER_LLM_MODEL=Toolstest
# Example for a hosted provider:
#   USER_LLM_BASE_URL=https://openrouter.ai/api/v1
#   USER_LLM_MODEL=openai/gpt-4o-mini
USER_LLM_API_KEY=your-api-key-here
USER_LLM_BASE_URL=http://localhost:20128/v1
USER_LLM_MODEL=Toolstest

# Server
PORT=3001
