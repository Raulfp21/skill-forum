# Copy to .env and fill in your own values.
# The app runs fully in MOCK MODE without these — chat answers are synthesized
# from retrieved document chunks with references. Set USER_LLM_API_KEY to
# enable real LLM answers.

# Your own LLM provider (OpenAI-compatible chat completions API)
USER_LLM_API_KEY=
USER_LLM_BASE_URL=https://api.openai.com/v1
USER_LLM_MODEL=gpt-4o-mini

# Server
PORT=3001
